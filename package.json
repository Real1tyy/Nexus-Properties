{
	"name": "nexus-properties",
	"version": "2.0.2",
	"description": "Automated property management plugin for Obsidian that syncs parent-child and related relationships bidirectionally with recursive tree properties.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "rm -f main.js"
	},
	"keywords": [
		"obsidian",
		"properties",
		"plugin",
		"frontmatter",
		"relationships",
		"automation"
	],
	"funding": {
		"type": "custom",
		"url": "https://matejvavroproductivity.com/support/"
	},
	"author": "Real1tyy",
	"license": "AGPL-3.0",
	"packageManager": "pnpm@9.0.0",
	"devDependencies": {
		"@types/cytoscape-dagre": "^2.3.4",
		"@types/node": "^24.10.9",
		"builtin-modules": "5.0.0",
		"esbuild": "0.25.11",
		"jsdom": "^27.4.0",
		"knip": "^5.81.0",
		"obsidian": "1.11.4",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@real1ty-obsidian-plugins": "file:./shared",
		"@svgdotjs/svg.js": "^3.2.4",
		"colord": "^2.9.3",
		"cytoscape": "^3.33.1",
		"cytoscape-dagre": "^2.5.0",
		"jose": "^6.2.1",
		"luxon": "^3.7.2",
		"obsidian": "^1.11.4",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1",
		"yaml": "^2.8.2",
		"zod": "^4.3.5"
	}
}
